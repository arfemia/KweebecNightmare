# Item names + tooltip descriptions for the grove blooms and the shrine. A description renders as
# rich text on the item tooltip's TextSpans (Hytale's native <i>/<b>/<color is="#hex">/\n markup,
# parsed client-side per locale, exactly like vanilla items.*.description). Each highlight colour
# matches the bloom's own glow. No balance numbers in the flavor, so a tuning change never forces a
# localization edit. The _Plant clusters are the harvest source; the thrown blooms drop from them.
item.moonbloom.name = Lunefleur
item.moonbloom.description = Offrez-la à un autel flétri pour purifier le bosquet, ou lancez-la pour <color is="#7affa0">étourdir</color> un chasseur là où elle éclate.\n\n<i>La dernière lumière pure du bosquet. Elle se souvient encore du chant que le Néant a voulu noyer.</i>
item.moonbloom_plant.name = Touffe de lunefleur
item.moonbloom_plant.description = Récoltez cette touffe luisante pour obtenir de la <color is="#7affa0">lunefleur</color>, la lumière que les autels boivent et que la chasse craint.\n\n<i>Même étouffé par la flétrissure, un peu de l'ancienne lumière du bosquet revient en rampant.</i>
item.gustbloom.name = Bourrasquefleur
item.gustbloom.description = Éclate en une <color is="#5a9cff">bourrasque</color> sèche qui repousse un chasseur et vous laisse de la place pour courir.\n\n<i>Elle retient son souffle depuis que le bosquet a respiré pur pour la dernière fois. Elle lâche tout d'un coup.</i>
item.gustbloom_plant.name = Touffe de bourrasquefleur
item.gustbloom_plant.description = Récoltez cette touffe battue par le vent pour obtenir de la <color is="#5a9cff">bourrasquefleur</color>, la fleur qui rejette un chasseur en arrière.\n\n<i>Elle ondule sans vent, respirant un air que le bosquet mort ne peut plus utiliser.</i>
item.mirebloom.name = Bourbefleur
item.mirebloom.description = Éclate en spores collantes qui <color is="#7affa0">ralentissent</color> tout ce qu'elles touchent. Réduisez la chasse à une lente reptation.\n\n<i>Elle a macéré dans les racines noyées où la flétrissure s'amasse le plus, et la fange colle à tout ce qui bouge.</i>
item.mirebloom_plant.name = Touffe de bourbefleur
item.mirebloom_plant.description = Récoltez cette touffe détrempée pour obtenir de la <color is="#7affa0">bourbefleur</color>, la fleur qui réduit la chasse à une lente reptation.\n\n<i>Elle prospère là où les racines se sont noyées, et s'engraisse de la pourriture stagnante.</i>
item.emberbloom.name = Braisefleur
item.emberbloom.description = Éclate en <color is="#ff8a3c">braises</color> brûlantes qui consument la flétrissure et épargnent les autres survivants.\n\n<i>Fendue dans l'écorce même du Gardien. Le feu est la seule forme que le Néant n'a jamais appris à revêtir.</i>
item.emberbloom_plant.name = Touffe de braisefleur
item.emberbloom_plant.description = Récoltez cette touffe qui couve pour obtenir de la <color is="#ff8a3c">braisefleur</color>, la fleur qui consume la flétrissure.\n\n<i>Elle ne prend racine que là où le Gardien a marché, et elle est toujours tiède au toucher.</i>
item.shrine.name = Autel flétri
item.shrine.description = Offrez ici de la <color is="#7affa0">lunefleur</color> pour purifier la flétrissure. Un autel rallumé brûle d'un feu vert, et la chasse se tourne vers la lumière.\n\n<i>Il portait jadis le chant du bosquet. Maintenant il attend, froid, que quelqu'un de chaud le réveille.</i>
item.warden_spawner.name = Perchoir du Gardien
item.blight_spawner.name = Nid de flétrissure


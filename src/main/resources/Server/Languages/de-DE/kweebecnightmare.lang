# Clash Host NPC + the clash_intro dialogue (the PvP entry).
npc.clashhost.name = Der Duellmeister
npc.clashhost.hint = Drücke [{key}], um die Arena zu betreten
dialogue.clash_intro.greet.text = Also. Du misst deine Wurzeln lieber an einem anderen Warmblüter, als vor der Dunkelheit zu fliehen. Das respektiere ich. Der Hain gibt eine feine Arena ab, wenn der einzige Albtraum darin ihr selbst seid. Bleib wachsam - ich habe bessere Kämpfer als dich begraben, und ich habe mich nicht einmal angestrengt.
dialogue.clash_intro.greet.opt.0 = Wie funktioniert die Arena?
dialogue.clash_intro.greet.opt.1 = Ich bin bereit zu kämpfen.
dialogue.clash_intro.greet.opt.2 = Zum Match, in dem ich schon bin...
dialogue.clash_intro.lore.text = Zwei Teams, ein Hain, und Pilze, die aus dem Boden sprießen: <color is="#5a9cff">Rückstoß</color>, um einen Narren über den Rand zu schleudern, <color is="#7affa0">Betäubung</color>, damit er glotzt, während du zuschlägst. Schnapp sie dir, bevor es die andere Seite tut - wer sammelt, geht meist auch wieder hinaus. Das letzte Team auf den Beinen gewinnt; läuft die Zeit ab, siegt, wer die meisten Schläge gelandet hat, also tanz nicht nur herum, triff etwas. In Domination vergiss all das und halte einfach den Boden länger als sie.
dialogue.clash_intro.lore.opt.0 = Genug. Lass mich kämpfen.
dialogue.clash_intro.lore.opt.1 = Ich überlege es mir anders, zurück.
dialogue.clash_intro.mode_pick.text = Nenne deinen Wettstreit, Warmblüter. Ich öffne das Tor zu dem Boden, auf dem du am liebsten bluten willst.
dialogue.clash_intro.mode_pick.opt.0 = Clash 1v1 - nur wir beide.
dialogue.clash_intro.mode_pick.opt.1 = Clash 2v2 - bring einen Freund zum Verlieren mit.
dialogue.clash_intro.mode_pick.opt.2 = Domination - halte den Boden.
dialogue.clash_intro.mode_pick.opt.3 = Noch nicht. Tritt zurück.
dialogue.clash_intro.already_engaged.text = Ein Kampf nach dem anderen, Warmblüter. Beende den Wettstreit, in dem du steckst, dann komm wieder und blute für mich.
dialogue.clash_intro.already_engaged.opt.0 = Verstanden.


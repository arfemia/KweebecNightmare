# Item names + tooltip descriptions for the grove blooms and the shrine. A description renders as
# rich text on the item tooltip's TextSpans (Hytale's native <i>/<b>/<color is="#hex">/\n markup,
# parsed client-side per locale, exactly like vanilla items.*.description). Each highlight colour
# matches the bloom's own glow. No balance numbers in the flavor, so a tuning change never forces a
# localization edit. The _Plant clusters are the harvest source; the thrown blooms drop from them.
item.moonbloom.name = Mondblüte
item.moonbloom.description = Opfere sie an einem verdorbenen Schrein, um den Hain zu reinigen, oder wirf sie, um einen Jäger dort, wo sie platzt, zu <color is="#7affa0">betäuben</color>.\n\n<i>Das letzte reine Licht des Hains. Sie erinnert sich noch an das Lied, das die Leere ertränken wollte.</i>
item.moonbloom_plant.name = Mondblütenbüschel
item.moonbloom_plant.description = Ernte dieses leuchtende Büschel, um <color is="#7affa0">Mondblüten</color> zu sammeln, das Licht, das die Schreine trinken und vor dem sich die Jagd fürchtet.\n\n<i>Selbst von der Fäulnis erstickt, kriecht ein wenig vom alten Licht des Hains immer wieder zurück.</i>
item.gustbloom.name = Böenblüte
item.gustbloom.description = Platzt in einer scharfen <color is="#5a9cff">Böe</color>, die einen Jäger zurückschleudert und dir Raum zum Fliehen verschafft.\n\n<i>Sie hält den Atem an, seit der Hain zuletzt rein geatmet hat. Dann lässt sie alles auf einmal los.</i>
item.gustbloom_plant.name = Böenblütenbüschel
item.gustbloom_plant.description = Ernte dieses windzerzauste Büschel, um <color is="#5a9cff">Böenblüten</color> zu sammeln, die Blüte, die einen Jäger zurückwirft.\n\n<i>Sie wiegt sich ohne Wind und atmet Luft, die der tote Hain nicht mehr braucht.</i>
item.mirebloom.name = Morastblüte
item.mirebloom.description = Platzt in klebrige Sporen, die alles <color is="#7affa0">verlangsamen</color>, was sie berühren. Zwinge die Jagd in die Knie.\n\n<i>Sie ist in den ertrunkenen Wurzeln gewuchert, wo sich die Fäulnis am dichtesten staut, und der Morast haftet an allem, was sich bewegt.</i>
item.mirebloom_plant.name = Morastblütenbüschel
item.mirebloom_plant.description = Ernte dieses durchnässte Büschel, um <color is="#7affa0">Morastblüten</color> zu sammeln, die Blüte, die die Jagd in die Knie zwingt.\n\n<i>Sie gedeiht, wo die Wurzeln ertrunken sind, und wird fett am stehenden Moder.</i>
item.emberbloom.name = Glutblüte
item.emberbloom.description = Platzt in sengende <color is="#ff8a3c">Glut</color>, die die Fäulnis verbrennt und deine Mitüberlebenden verschont.\n\n<i>Aus der Rinde des Wärters selbst gesprungen. Feuer ist die eine Gestalt, die die Leere nie zu tragen lernte.</i>
item.emberbloom_plant.name = Glutblütenbüschel
item.emberbloom_plant.description = Ernte dieses glimmende Büschel, um <color is="#ff8a3c">Glutblüten</color> zu sammeln, die Blüte, die die Fäulnis wegbrennt.\n\n<i>Sie schlägt nur dort Wurzeln, wo der Wärter gegangen ist, und fühlt sich immer warm an.</i>
item.shrine.name = Verdorbener Schrein
item.shrine.description = Opfere hier <color is="#7affa0">Mondblüten</color>, um die Fäulnis zu reinigen. Ein neu entzündeter Schrein brennt mit grünem Feuer, und die Jagd wendet sich dem Licht zu.\n\n<i>Einst trug er das Lied des Hains. Nun wartet er kalt auf jemand Warmen, der ihn weckt.</i>
item.warden_spawner.name = Wärterhorst
item.blight_spawner.name = Fäulnisnest


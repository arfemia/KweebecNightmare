# Item names + tooltip descriptions for the grove blooms and the shrine. A description renders as
# rich text on the item tooltip's TextSpans (Hytale's native <i>/<b>/<color is="#hex">/\n markup,
# parsed client-side per locale, exactly like vanilla items.*.description). Each highlight colour
# matches the bloom's own glow. No balance numbers in the flavor, so a tuning change never forces a
# localization edit. The _Plant clusters are the harvest source; the thrown blooms drop from them.
item.moonbloom.name = Flor Lunar
item.moonbloom.description = Ofrécela en un santuario plagado para purificar el bosquecillo, o lánzala para <color is="#7affa0">aturdir</color> a un cazador donde estalle.\n\n<i>La última luz limpia del bosquecillo. Aún recuerda la canción que el Vacío quiso ahogar.</i>
item.moonbloom_plant.name = Racimo de Flor Lunar
item.moonbloom_plant.description = Cosecha este racimo brillante para reunir <color is="#7affa0">Flor Lunar</color>, la luz que beben los santuarios y que la cacería teme.\n\n<i>Hasta ahogado por la plaga, un poco de la vieja luz del bosquecillo sigue volviendo a asomar.</i>
item.gustbloom.name = Flor de Ráfaga
item.gustbloom.description = Estalla en una <color is="#5a9cff">ráfaga</color> seca que lanza hacia atrás a un cazador y te da espacio para huir.\n\n<i>Lleva aguantando la respiración desde que el bosquecillo respiró limpio por última vez. La suelta de golpe.</i>
item.gustbloom_plant.name = Racimo de Flor de Ráfaga
item.gustbloom_plant.description = Cosecha este racimo azotado por el viento para reunir <color is="#5a9cff">Flor de Ráfaga</color>, la flor que lanza hacia atrás a un cazador.\n\n<i>Se mece aunque no haya viento, respirando un aire que el bosquecillo muerto ya no puede usar.</i>
item.mirebloom.name = Flor del Fango
item.mirebloom.description = Estalla en esporas pegajosas que <color is="#7affa0">ralentizan</color> todo lo que tocan. Reduce a la cacería a un arrastre.\n\n<i>Se pudrió en las raíces anegadas, donde la plaga se acumula más espesa, y el fango se pega a todo lo que se mueve.</i>
item.mirebloom_plant.name = Racimo de Flor del Fango
item.mirebloom_plant.description = Cosecha este racimo empapado para reunir <color is="#7affa0">Flor del Fango</color>, la flor que reduce a la cacería a un arrastre.\n\n<i>Prospera donde las raíces se han ahogado, engordando con la podredumbre estancada.</i>
item.emberbloom.name = Flor de Brasa
item.emberbloom.description = Estalla en <color is="#ff8a3c">brasas</color> abrasadoras que queman a la plaga y respetan a tus compañeros supervivientes.\n\n<i>Arrancada de la corteza del propio Guardián. El fuego es la única forma que el Vacío nunca aprendió a vestir.</i>
item.emberbloom_plant.name = Racimo de Flor de Brasa
item.emberbloom_plant.description = Cosecha este racimo humeante para reunir <color is="#ff8a3c">Flor de Brasa</color>, la flor que quema la plaga hasta borrarla.\n\n<i>Solo arraiga donde ha pisado el Guardián, y siempre está tibia al tacto.</i>
item.shrine.name = Santuario Plagado
item.shrine.description = Ofrece aquí <color is="#7affa0">Flor Lunar</color> para purificar la plaga. Un santuario reencendido arde con fuego verde, y la cacería se vuelve hacia la luz.\n\n<i>Antes llevaba la canción del bosquecillo. Ahora espera, frío, a que alguien cálido lo despierte.</i>
item.warden_spawner.name = Nido del Guardián
item.blight_spawner.name = Nido de la Plaga


# Clash Host NPC + the clash_intro dialogue (the PvP entry).
npc.clashhost.name = El Maestro de Duelos
npc.clashhost.hint = Pulsa [{key}] para entrar en la arena
dialogue.clash_intro.greet.text = Conque prefieres probar tus raíces contra otra sangre caliente antes que huir de la oscuridad. Lo respeto. El bosquecillo es una buena arena cuando la única pesadilla que hay en él sois vosotros. Mantente alerta: he enterrado a mejores luchadores que tú, y ni siquiera lo intentaba.
dialogue.clash_intro.greet.opt.0 = ¿Cómo funciona la arena?
dialogue.clash_intro.greet.opt.1 = Estoy listo para luchar.
dialogue.clash_intro.greet.opt.2 = Sobre la partida en la que ya estoy...
dialogue.clash_intro.lore.text = Dos equipos, un bosquecillo y setas brotando del suelo: <color is="#5a9cff">retroceso</color> para mandar a un necio volando por el borde, <color is="#7affa0">aturdimiento</color> para dejarlo pasmado mientras tú golpeas. Cógelas antes de que lo haga el otro bando: quienes rebuscan suelen ser quienes salen caminando. El último equipo en pie se lleva la partida; si se acaba el tiempo, gana quien haya dado más golpes, así que no te limites a bailar, golpea algo. En Dominio, olvida todo eso y limítate a mantener el terreno más tiempo que ellos.
dialogue.clash_intro.lore.opt.0 = Basta. Déjame luchar.
dialogue.clash_intro.lore.opt.1 = Pensándolo mejor, vuelve atrás.
dialogue.clash_intro.mode_pick.text = Elige tu contienda, sangre caliente. Abriré la puerta al terreno donde prefieras sangrar.
dialogue.clash_intro.mode_pick.opt.0 = Choque 1v1: solo nosotros dos.
dialogue.clash_intro.mode_pick.opt.1 = Choque 2v2: trae a un amigo con quien perder.
dialogue.clash_intro.mode_pick.opt.2 = Dominio: mantén el terreno.
dialogue.clash_intro.mode_pick.opt.3 = Todavía no. Atrás.
dialogue.clash_intro.already_engaged.text = Una pelea cada vez, sangre caliente. Termina la contienda en la que estás y luego vuelve a sangrar para mí.
dialogue.clash_intro.already_engaged.opt.0 = Entendido.


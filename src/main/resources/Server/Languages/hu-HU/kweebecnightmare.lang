# Item names + tooltip descriptions for the grove blooms and the shrine. A description renders as
# rich text on the item tooltip's TextSpans (Hytale's native <i>/<b>/<color is="#hex">/\n markup,
# parsed client-side per locale, exactly like vanilla items.*.description). Each highlight colour
# matches the bloom's own glow. No balance numbers in the flavor, so a tuning change never forces a
# localization edit. The _Plant clusters are the harvest source; the thrown blooms drop from them.
item.moonbloom.name = Holdvirág
item.moonbloom.description = Ajánld fel egy megrontott szentélyben a liget megtisztításához, vagy hajítsd el, hogy <color is="#7affa0">elkábítsd</color> a vadászt, ahol szétpukkad.\n\n<i>A liget utolsó tiszta fénye. Még emlékszik a dalra, amelyet az Űr el akart fojtani.</i>
item.moonbloom_plant.name = Holdvirág-csokor
item.moonbloom_plant.description = Szüreteld le ezt a ragyogó csokrot, hogy <color is="#7affa0">Holdvirágot</color> gyűjts, azt a fényt, amelyet a szentélyek isznak, és a hajsza retteg.\n\n<i>A rontástól fojtogatva is visszasurran egy kevés a liget régi fényéből.</i>
item.gustbloom.name = Szélvirág
item.gustbloom.description = Éles <color is="#5a9cff">széllökéssel</color> pukkan szét, amely hátralöki a vadászt, és helyet ad a futáshoz.\n\n<i>Azóta tartja vissza a lélegzetét, hogy a liget utoljára tisztán lélegzett. Egyszerre ereszti ki.</i>
item.gustbloom_plant.name = Szélvirág-csokor
item.gustbloom_plant.description = Szüreteld le ezt a szélfútta csokrot, hogy <color is="#5a9cff">Szélvirágot</color> gyűjts, azt a virágot, amely hátralöki a vadászt.\n\n<i>Ringatózik, amikor nincs szél, és olyan levegőt lélegzik, amelyet a halott liget már nem tud használni.</i>
item.mirebloom.name = Mocsárvirág
item.mirebloom.description = Tapadós spórákká pukkan szét, amelyek <color is="#7affa0">lelassítanak</color> mindent, amihez hozzáérnek. Kényszerítsd csigatempóra a hajszát.\n\n<i>A vízbe fúlt gyökerek közt rothadt meg, ahol a rontás a legsűrűbben gyűlik, és a sár mindenbe belekapaszkodik, ami mozog.</i>
item.mirebloom_plant.name = Mocsárvirág-csokor
item.mirebloom_plant.description = Szüreteld le ezt az átázott csokrot, hogy <color is="#7affa0">Mocsárvirágot</color> gyűjts, azt a virágot, amely csigatempóra lassítja a hajszát.\n\n<i>Ott él, ahol a gyökerek megfulladtak, és az álló rothadáson hízik.</i>
item.emberbloom.name = Parázsvirág
item.emberbloom.description = Perzselő <color is="#ff8a3c">parázzsá</color> pukkan szét, amely égeti a rontást, és megkíméli a társaidat.\n\n<i>Az Őrző saját kérgéből repedt le. A tűz az egyetlen alak, amelyet az Űr sosem tanult meg ölteni.</i>
item.emberbloom_plant.name = Parázsvirág-csokor
item.emberbloom_plant.description = Szüreteld le ezt a parázsló csokrot, hogy <color is="#ff8a3c">Parázsvirágot</color> gyűjts, azt a virágot, amely elégeti a rontást.\n\n<i>Csak ott ver gyökeret, ahol az Őrző járt, és mindig meleg tapintású.</i>
item.shrine.name = Megrontott Szentély
item.shrine.description = Ajánlj fel itt <color is="#7affa0">Holdvirágot</color> a rontás megtisztításához. Az újra meggyújtott szentély zöld lánggal ég, és a hajsza a fény felé fordul.\n\n<i>Valaha a liget dalát hordozta. Most hidegen vár valakire, aki meleg, hogy felébressze.</i>
item.warden_spawner.name = Őrzői Ülőrúd
item.blight_spawner.name = Rontásfészek


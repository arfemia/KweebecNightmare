# Item names + tooltip descriptions for the grove blooms and the shrine. A description renders as
# rich text on the item tooltip's TextSpans (Hytale's native <i>/<b>/<color is="#hex">/\n markup,
# parsed client-side per locale, exactly like vanilla items.*.description). Each highlight colour
# matches the bloom's own glow. No balance numbers in the flavor, so a tuning change never forces a
# localization edit. The _Plant clusters are the harvest source; the thrown blooms drop from them.
item.moonbloom.name = Flor-lunar
item.moonbloom.description = Ofereça num santuário infectado para purificar o bosque, ou arremesse para <color is="#7affa0">atordoar</color> um caçador onde ela estourar.\n\n<i>A última luz limpa do bosque. Ela ainda lembra a canção que o Vazio tentou afogar.</i>
item.moonbloom_plant.name = Touceira de Flor-lunar
item.moonbloom_plant.description = Colha esta touceira brilhante para juntar <color is="#7affa0">Flor-lunar</color>, a luz que os santuários bebem e que a caçada teme.\n\n<i>Mesmo sufocada pela praga, um pouco da velha luz do bosque continua voltando.</i>
item.gustbloom.name = Flor-rajada
item.gustbloom.description = Estoura numa <color is="#5a9cff">rajada</color> forte que joga um caçador para trás e dá espaço para você correr.\n\n<i>Segura o fôlego desde a última vez que o bosque respirou limpo. Solta tudo de uma vez.</i>
item.gustbloom_plant.name = Touceira de Flor-rajada
item.gustbloom_plant.description = Colha esta touceira varrida pelo vento para juntar <color is="#5a9cff">Flor-rajada</color>, a flor que joga um caçador para trás.\n\n<i>Balança sem vento nenhum, respirando um ar que o bosque morto não consegue mais usar.</i>
item.mirebloom.name = Flor-lodo
item.mirebloom.description = Estoura em esporos grudentos que <color is="#7affa0">retardam</color> tudo o que tocam. Reduza a caçada a um rastejo.\n\n<i>Apodreceu nas raízes afogadas, onde a praga se acumula mais, e o lodo gruda em tudo o que se move.</i>
item.mirebloom_plant.name = Touceira de Flor-lodo
item.mirebloom_plant.description = Colha esta touceira encharcada para juntar <color is="#7affa0">Flor-lodo</color>, a flor que reduz a caçada a um rastejo.\n\n<i>Prospera onde as raízes se afogaram, engordando com a podridão parada.</i>
item.emberbloom.name = Flor-brasa
item.emberbloom.description = Estoura em <color is="#ff8a3c">brasas</color> escaldantes que queimam a praga e poupam seus companheiros sobreviventes.\n\n<i>Rachada da casca do próprio Vigia. O fogo é a única forma que o Vazio nunca aprendeu a vestir.</i>
item.emberbloom_plant.name = Touceira de Flor-brasa
item.emberbloom_plant.description = Colha esta touceira em brasa para juntar <color is="#ff8a3c">Flor-brasa</color>, a flor que queima a praga até sumir.\n\n<i>Só cria raiz onde o Vigia passou, e está sempre quente ao toque.</i>
item.shrine.name = Santuário Infectado
item.shrine.description = Ofereça <color is="#7affa0">Flor-lunar</color> aqui para purificar a praga. Um santuário reaceso arde em fogo verde, e a caçada se volta para a luz.\n\n<i>Um dia carregou a canção do bosque. Agora espera, frio, que alguém quente o desperte.</i>
item.warden_spawner.name = Poleiro do Vigia
item.blight_spawner.name = Ninho da Praga


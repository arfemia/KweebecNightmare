# Item names + tooltip descriptions for the grove blooms and the shrine. A description renders as
# rich text on the item tooltip's TextSpans (Hytale's native <i>/<b>/<color is="#hex">/\n markup,
# parsed client-side per locale, exactly like vanilla items.*.description). Each highlight colour
# matches the bloom's own glow. No balance numbers in the flavor, so a tuning change never forces a
# localization edit. The _Plant clusters are the harvest source; the thrown blooms drop from them.
item.moonbloom.name = Ay Gülü
item.moonbloom.description = Koruyu arındırmak için çürümüş bir türbeye sun ya da patladığı yerde bir avcıyı <color is="#7affa0">sersemletmek</color> için fırlat.\n\n<i>Korunun son temiz ışığı. Boşluk'un boğmaya çalıştığı şarkıyı hâlâ hatırlıyor.</i>
item.moonbloom_plant.name = Ay Gülü Öbeği
item.moonbloom_plant.description = Türbelerin içtiği, avın korktuğu ışık olan <color is="#7affa0">Ay Gülü</color> toplamak için bu parlayan öbeği hasat et.\n\n<i>Çürümeyle boğulsa da korunun eski ışığından biraz hâlâ geri sürünüyor.</i>
item.gustbloom.name = Esinti Gülü
item.gustbloom.description = Keskin bir <color is="#5a9cff">esintiyle</color> patlayıp avcıyı geri savurur ve sana koşacak yer kazandırır.\n\n<i>Koru en son temiz nefes aldığından beri nefesini tutuyor. Hepsini bir anda bırakıyor.</i>
item.gustbloom_plant.name = Esinti Gülü Öbeği
item.gustbloom_plant.description = Avcıyı geri savuran çiçek olan <color is="#5a9cff">Esinti Gülü</color> toplamak için rüzgârlı bu öbeği hasat et.\n\n<i>Rüzgâr yokken de sallanıyor, ölü korunun artık kullanamadığı havayı soluyor.</i>
item.mirebloom.name = Bataklık Gülü
item.mirebloom.description = Dokunduğu her şeyi <color is="#7affa0">yavaşlatan</color> yapışkan sporlarla patlar. Avı emekler hâle getir.\n\n<i>Çürümenin en yoğun biriktiği batık köklerde çürüdü ve bataklık kıpırdayan her şeye yapışır.</i>
item.mirebloom_plant.name = Bataklık Gülü Öbeği
item.mirebloom_plant.description = Avı emekler hâle getiren çiçek olan <color is="#7affa0">Bataklık Gülü</color> toplamak için bu sırılsıklam öbeği hasat et.\n\n<i>Köklerin boğulduğu yerde yetişir, durgun çürümeyle semirir.</i>
item.emberbloom.name = Kor Gülü
item.emberbloom.description = Çürümeyi yakan, diğer hayatta kalanları esirgeyen kavurucu <color is="#ff8a3c">korlarla</color> patlar.\n\n<i>Bekçi'nin kendi kabuğundan kopmuş. Ateş, Boşluk'un bürünmeyi öğrenemediği tek biçim.</i>
item.emberbloom_plant.name = Kor Gülü Öbeği
item.emberbloom_plant.description = Çürümeyi yakıp yok eden çiçek olan <color is="#ff8a3c">Kor Gülü</color> toplamak için bu közlenen öbeği hasat et.\n\n<i>Yalnızca Bekçi'nin yürüdüğü yerde kök salar ve dokununca hep sıcaktır.</i>
item.shrine.name = Çürümüş Türbe
item.shrine.description = Çürümeyi arındırmak için buraya <color is="#7affa0">Ay Gülü</color> sun. Yeniden yanan türbe yeşil ateşle yanar ve av ışığa döner.\n\n<i>Bir zamanlar korunun şarkısını taşırdı. Şimdi onu uyandıracak sıcak birini soğuk soğuk bekliyor.</i>
item.warden_spawner.name = Bekçi Tüneği
item.blight_spawner.name = Çürüme Yuvası


# Clash Host NPC + the clash_intro dialogue (the PvP entry).
npc.clashhost.name = Düello Ustası
npc.clashhost.hint = Arenaya girmek için [{key}] tuşuna bas
dialogue.clash_intro.greet.text = Demek öyle. Karanlıktan kaçmak yerine köklerini başka bir sıcak kanlıya karşı denemeyi seçtin. Saygı duyarım. İçindeki tek kâbus birbirinizsiniz diye koru güzel bir arena olur. Keskin kal: senden iyi dövüşçüleri gömdüm, üstelik denemiyordum bile.
dialogue.clash_intro.greet.opt.0 = Arena nasıl işliyor?
dialogue.clash_intro.greet.opt.1 = Dövüşmeye hazırım.
dialogue.clash_intro.greet.opt.2 = Zaten içinde olduğum maç hakkında...
dialogue.clash_intro.lore.text = İki takım, bir koru ve topraktan fışkıran mantarlar: bir budalayı kenardan uçurmak için <color is="#5a9cff">geri savurma</color>, sen vururken ağzı açık bırakmak için <color is="#7affa0">sersemletme</color>. Karşı taraftan önce kap: toplayanlar genelde çıkıp gidenler olur. Ayakta kalan son takım alır; süre biterse en çok vuruşu yapan kazanır, o yüzden dans etme, bir şeye vur. Hâkimiyette bunların hepsini unut, zemini onlardan uzun tut yeter.
dialogue.clash_intro.lore.opt.0 = Yeter. Dövüşeyim.
dialogue.clash_intro.lore.opt.1 = Düşündüm de, geri dön.
dialogue.clash_intro.mode_pick.text = Müsabakanı söyle, sıcak kanlı. Kanını dökmek istediğin zemine kapıyı açarım.
dialogue.clash_intro.mode_pick.opt.0 = Çatışma 1v1 - sadece ikimiz.
dialogue.clash_intro.mode_pick.opt.1 = Çatışma 2v2 - birlikte kaybedeceğin bir dost getir.
dialogue.clash_intro.mode_pick.opt.2 = Hâkimiyet - zemini tut.
dialogue.clash_intro.mode_pick.opt.3 = Henüz değil. Geri çekil.
dialogue.clash_intro.already_engaged.text = Her seferinde tek dövüş, sıcak kanlı. İçinde olduğun müsabakayı bitir, sonra gel yine benim için kan dök.
dialogue.clash_intro.already_engaged.opt.0 = Anladım.


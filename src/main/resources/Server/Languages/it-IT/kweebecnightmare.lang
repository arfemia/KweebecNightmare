# Item names + tooltip descriptions for the grove blooms and the shrine. A description renders as
# rich text on the item tooltip's TextSpans (Hytale's native <i>/<b>/<color is="#hex">/\n markup,
# parsed client-side per locale, exactly like vanilla items.*.description). Each highlight colour
# matches the bloom's own glow. No balance numbers in the flavor, so a tuning change never forces a
# localization edit. The _Plant clusters are the harvest source; the thrown blooms drop from them.
item.moonbloom.name = Fiore di Luna
item.moonbloom.description = Offrilo a un santuario appestato per purificare il bosco, oppure scaglialo per <color is="#7affa0">stordire</color> un cacciatore dove esplode.\n\n<i>L'ultima luce pulita del bosco. Ricorda ancora il canto che il Vuoto tentò di soffocare.</i>
item.moonbloom_plant.name = Ciuffo di Fiori di Luna
item.moonbloom_plant.description = Raccogli questo ciuffo luminoso per ottenere il <color is="#7affa0">Fiore di Luna</color>, la luce che i santuari bevono e la caccia teme.\n\n<i>Anche soffocata dalla peste, un po' dell'antica luce del bosco continua a farsi strada.</i>
item.gustbloom.name = Fiore di Vento
item.gustbloom.description = Esplode in una <color is="#5a9cff">raffica</color> secca che scaglia indietro un cacciatore e ti dà spazio per correre.\n\n<i>Trattiene il respiro da quando il bosco ha respirato aria pulita per l'ultima volta. Lo lascia andare tutto insieme.</i>
item.gustbloom_plant.name = Ciuffo di Fiori di Vento
item.gustbloom_plant.description = Raccogli questo ciuffo sferzato dal vento per ottenere il <color is="#5a9cff">Fiore di Vento</color>, il fiore che respinge un cacciatore.\n\n<i>Ondeggia anche senza vento, respirando un'aria che il bosco morto non sa più usare.</i>
item.mirebloom.name = Fiore di Palude
item.mirebloom.description = Esplode in spore appiccicose che <color is="#7affa0">rallentano</color> tutto ciò che toccano. Riduci la caccia a un passo di lumaca.\n\n<i>È marcito nelle radici annegate, dove la peste ristagna più fitta, e la palude si aggrappa a tutto ciò che si muove.</i>
item.mirebloom_plant.name = Ciuffo di Fiori di Palude
item.mirebloom_plant.description = Raccogli questo ciuffo fradicio per ottenere il <color is="#7affa0">Fiore di Palude</color>, il fiore che riduce la caccia a un passo di lumaca.\n\n<i>Prospera dove le radici sono annegate, ingrassando sul marciume stagnante.</i>
item.emberbloom.name = Fiore di Brace
item.emberbloom.description = Esplode in <color is="#ff8a3c">braci</color> roventi che bruciano la peste e risparmiano i tuoi compagni sopravvissuti.\n\n<i>Staccato dalla corteccia stessa del Guardiano. Il fuoco è l'unica forma che il Vuoto non ha mai imparato a indossare.</i>
item.emberbloom_plant.name = Ciuffo di Fiori di Brace
item.emberbloom_plant.description = Raccogli questo ciuffo fumante per ottenere il <color is="#ff8a3c">Fiore di Brace</color>, il fiore che brucia via la peste.\n\n<i>Mette radici solo dove è passato il Guardiano, ed è sempre caldo al tatto.</i>
item.shrine.name = Santuario Appestato
item.shrine.description = Offri qui il <color is="#7affa0">Fiore di Luna</color> per purificare la peste. Un santuario riacceso arde di fuoco verde, e la caccia si volge verso la luce.\n\n<i>Un tempo portava il canto del bosco. Ora attende, freddo, che qualcuno di caldo lo svegli.</i>
item.warden_spawner.name = Nido del Guardiano
item.blight_spawner.name = Nido della Peste

